{
  "name": "muno",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adiona/muno trip-planner frontend and playbook home base.",
  "scripts": {
    "dev": "vite",
    "contracts": "node scripts/generate_widget_contracts.mjs",
    "type-check": "npm run contracts && tsc --noEmit",
    "build": "npm run contracts && tsc --noEmit && vite build",
    "build:cf": "npm ci && npm run build",
    "deploy:cf": "npx wrangler pages deploy dist --project-name muno --branch main",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "smoke:widgets": "node scripts/widget_dispatch_smoke.mjs"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.16.2",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@fontsource/inter": "^5.2.8",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@vis.gl/react-google-maps": "^1.8.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.12.0",
    "date-fns": "^4.1.0",
    "firebase": "^11.0.0",
    "i18next": "^23.16.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.8",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
