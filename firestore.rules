rules_version = '2';
// Deny all direct client access. No browser or Firebase SDK client reads or
// writes Firestore: the apps go through the gateway, and every read and write
// happens in a playbook on the worker's service account (mcp/firestore and the
// planner's inline REST), which these rules do not govern.
//
// This replaces the v1 demo rules, which allowed public reads of chat_threads/**,
// trips/** and users/** (noetl/gateway advisory GHSA-qxw3-x3fw-qp2c, item 10).
// Those were never deployed; this file is the safe state if it ever is.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
