{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noetl.github.io/muno/widget-contract/transfer_list.schema.json",
  "title": "TransferListPayload",
  "description": "List of HotelBeds transfer availability cards.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "items",
    "total_count"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transfer_id",
          "currency"
        ],
        "properties": {
          "transfer_id": {
            "type": "string"
          },
          "transfer_type": {
            "type": "string"
          },
          "vehicle_name": {
            "type": "string"
          },
          "category_name": {
            "type": "string"
          },
          "total_amount": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "ctas": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "view_details",
                "add_to_itinerary"
              ]
            }
          }
        }
      }
    },
    "total_count": {
      "type": "integer",
      "minimum": 0
    },
    "route_summary": {
      "type": "string"
    }
  }
}
