{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noetl.github.io/muno/widget-contract/order_confirmation.schema.json",
  "title": "OrderConfirmationPayload",
  "description": "Duffel test order receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "booking_reference",
    "total_amount",
    "total_currency"
  ],
  "properties": {
    "order_id": {
      "type": "string"
    },
    "booking_reference": {
      "type": "string"
    },
    "total_amount": {
      "type": "string"
    },
    "total_currency": {
      "type": "string"
    },
    "passengers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "ctas": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "view_full",
          "new_search"
        ]
      }
    },
    "documents": {
      "type": "array",
      "description": "Duffel-issued documents for the order (itinerary receipt PDF, etc.). Each item has a document_url that can be opened directly. Duffel test environment may emit entries with null document_url; the Duffel MCP filters those out, but the schema tolerates null as a defensive measure.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "unique_identifier": {
            "type": ["string", "null"]
          },
          "type": {
            "type": ["string", "null"]
          },
          "document_url": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
