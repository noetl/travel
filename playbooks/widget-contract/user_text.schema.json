{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noetl.github.io/muno/widget-contract/user_text.schema.json",
  "title": "UserTextPayload",
  "description": "User echo bubble.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text"
  ],
  "properties": {
    "text": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "user_avatar_url": {
      "type": "string",
      "format": "uri"
    }
  }
}
