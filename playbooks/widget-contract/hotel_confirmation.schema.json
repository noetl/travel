{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noetl.github.io/muno/widget-contract/hotel_confirmation.schema.json",
  "title": "HotelConfirmationPayload",
  "description": "HotelBeds test-environment booking receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "booking_reference",
    "hotel_name",
    "total_amount",
    "total_currency"
  ],
  "properties": {
    "booking_reference": {
      "type": "string"
    },
    "hotel_name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "check_in": {
      "type": "string"
    },
    "check_out": {
      "type": "string"
    },
    "total_amount": {
      "type": "string"
    },
    "total_currency": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "ctas": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "view_full",
          "new_search"
        ]
      }
    }
  }
}
