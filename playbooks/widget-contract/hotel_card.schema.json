{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noetl.github.io/muno/widget-contract/hotel_card.schema.json",
  "title": "HotelCardPayload",
  "description": "Single hotel property card.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hotel_id",
    "name",
    "score",
    "photos",
    "amenities",
    "currency"
  ],
  "properties": {
    "hotel_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "city": {
          "type": "string"
        }
      }
    },
    "star_rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "score_count": {
      "type": "integer",
      "minimum": 0
    },
    "thumb_up_count": {
      "type": "integer",
      "minimum": 0
    },
    "thumb_down_count": {
      "type": "integer",
      "minimum": 0
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "price_per_night": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string"
    },
    "rooms_matching": {
      "type": "integer",
      "minimum": 0
    },
    "available_rooms": {
      "type": "integer",
      "minimum": 0
    },
    "address": {
      "type": "string"
    },
    "distance_from_center": {
      "type": "string"
    },
    "rate_key": {
      "type": "string",
      "description": "Bookable HotelBeds rateKey carried from search so the Book CTA can drive book_hotel (noetl/ai-meta#162)."
    },
    "ctas": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "watch_in_detail",
          "show_numbers",
          "book"
        ]
      }
    },
    "ai_adjustments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "emphasis": {
          "type": "string"
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "text"
            ],
            "properties": {
              "target": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "maxLength": 240
              },
              "kind": {
                "type": "string",
                "enum": [
                  "info",
                  "warning",
                  "success",
                  "error"
                ]
              }
            }
          }
        },
        "upsell_banner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "action_label"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "action_label": {
              "type": "string"
            },
            "action_id": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
