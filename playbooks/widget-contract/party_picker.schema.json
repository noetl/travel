{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noetl.github.io/muno/widget-contract/party_picker.schema.json",
  "title": "PartyPickerPayload",
  "description": "Interactive traveller party picker.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rooms_max",
    "adults_max",
    "children_max",
    "allow_child_ages"
  ],
  "properties": {
    "rooms_max": {
      "type": "integer",
      "minimum": 1
    },
    "adults_max": {
      "type": "integer",
      "minimum": 1
    },
    "children_max": {
      "type": "integer",
      "minimum": 0
    },
    "allow_child_ages": {
      "type": "boolean"
    },
    "submitted_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rooms",
        "adults",
        "children"
      ],
      "properties": {
        "rooms": {
          "type": "integer",
          "minimum": 1
        },
        "adults": {
          "type": "integer",
          "minimum": 1
        },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "age"
            ],
            "properties": {
              "age": {
                "type": "integer",
                "minimum": 0,
                "maximum": 17
              }
            }
          }
        }
      }
    }
  }
}
