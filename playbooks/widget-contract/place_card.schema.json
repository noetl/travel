{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noetl.github.io/muno/widget-contract/place_card.schema.json",
  "title": "PlaceCardPayload",
  "description": "Single place result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "place_id",
    "name",
    "types",
    "photos"
  ],
  "properties": {
    "place_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "rating_count": {
      "type": "integer",
      "minimum": 0
    },
    "opening_hours": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "ctas": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "view_details",
          "add_to_itinerary"
        ]
      }
    }
  }
}
