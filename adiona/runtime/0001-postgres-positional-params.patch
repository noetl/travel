+#[cfg(test)]
+mod positional_parameter_tests {
+    use super::ToolDefinition;
+    #[test]
+    fn preserves_postgres_bound_values_and_http_query_objects() {
+        for (yaml, expected) in [
+            ("kind: postgres\ncommand: SELECT $1::text\nparams: [\"{{ request | tojson }}\"]\n", serde_json::json!(["{{ request | tojson }}"])),
+            ("kind: http\nurl: https://example.invalid\nparams: {page: 2}\n", serde_json::json!({"page":2})),
+        ] {
+            let tool: ToolDefinition = serde_yaml::from_str(yaml).unwrap();
+            let value = serde_json::to_value(tool).unwrap();
+            assert_eq!(value["params"], expected);
+        }
+    }
+}
