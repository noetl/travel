            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          {
            "name": "X-Demo-Principal",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "demo-staff",
                "demo-worker",
                "other-staff",
                "other-worker"
              ]
            },
            "description": "DEVELOPMENT ONLY. Real caller identity must be cryptographically verified."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "property_id",
                  "room_id",
                  "arrival",
                  "departure",
                  "guests"
                ],
                "properties": {
                  "property_id": {
                    "type": "string"
                  },
                  "room_id": {
                    "type": "string"
                  },
                  "arrival": {
                    "type": "string",
                    "format": "date"
                  },
                  "departure": {
                    "type": "string",
                    "format": "date"
                  },
                  "guests": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Command committed; inspect returned business state.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "quote_id",
                    "tenant_id",
                    "property_id",
                    "room_id",
                    "arrival",
                    "departure",
                    "guests",
                    "nights",
                    "subtotal_minor",
                    "tax_minor",
                    "amount_minor",
                    "currency",
                    "policy_version",
                    "expires_at"
                  ],
                  "properties": {
                    "quote_id": {
                      "type": "string"
                    },
                    "tenant_id": {
                      "type": "string"
                    },
                    "property_id": {
                      "type": "string"
                    },
                    "room_id": {
                      "type": "string"
                    },
